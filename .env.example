# Environment identity. Never point development or preview builds at production data.
NEXT_PUBLIC_APP_URL=https://orbit.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only Supabase identity. Prefer a scoped/new secret when supported.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Independent 32+ character key for OAuth state and encrypted integration tokens.
# Never reuse a Supabase, OAuth, cron, worker, webhook, or provider secret here.
INTEGRATION_SECRET=

# Orbit GitHub App
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=https://orbit.example.com/api/integrations/github/callback

# Orbit Vercel Integration
VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=https://orbit.example.com/api/integrations/vercel/callback

# Google / Meta / LinkedIn OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Internal worker identities. Keep these independent.
CRON_SECRET=
ORBIT_AUTOPILOT_WORKER_SECRET=
FOUNDRY_WORKER_SECRET=
FOUNDRY_APP_URL=https://orbit.example.com

# Legacy Stage 4 HTTP gateway and inbound-event signing. These are separate
# credential domains and must not reuse cron/worker/integration secrets.
ORBIT_EXTERNAL_ACTIONS_ENABLED=false
ORBIT_EXTERNAL_ACTION_GATEWAY_URL=https://orbit.example.com/api/internal/external-action-gateway
ORBIT_EXTERNAL_ACTION_GATEWAY_SECRET=
ORBIT_INBOUND_EVENT_SECRET=

# Stage 4 provider identity policy.
# "workspace" is the production default and uses each workspace's encrypted Vault settings.
# Set "platform" only when the product intentionally provides a shared Urava sending identity.
ORBIT_PROVIDER_CREDENTIAL_MODE=workspace
RESEND_API_KEY=
ORBIT_EMAIL_FROM=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
ORBIT_WHATSAPP_TEMPLATE_OUTREACH=
ORBIT_WHATSAPP_TEMPLATE_FOLLOWUP=
# Every Orbit sales template must contain exactly one body text variable ({{1}}).
# Orbit passes the frozen approved message into that variable and fails closed
# when the body is empty or exceeds WhatsApp's 1,024-character variable limit.
ORBIT_WHATSAPP_TEMPLATE_PROPOSAL=
ORBIT_WHATSAPP_TEMPLATE_PAYMENT_REQUEST=
ORBIT_WHATSAPP_TEMPLATE_REFERRAL=
ORBIT_WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Foundry external sync
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_STUDENTS_TABLE_ID=
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2026-03-11

# Foundry notification providers
FOUNDRY_EMAIL_FROM=Urava Foundry <updates@example.com>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=foundry_update
WHATSAPP_TEMPLATE_LANGUAGE=en_US
