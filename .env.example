# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://sjtgydpwsnjwxlwbtpgf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only Supabase key. Prefer the new sb_secret_ key; the legacy service
# role key is supported as a fallback.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orbit platform integration security. This protects OAuth state and encrypts
# provider access tokens before they are persisted server-side.
INTEGRATION_SECRET=

# Orbit GitHub App (one-time platform setup; normal Orbit users never see these)
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=https://orbit-two-delta.vercel.app/api/integrations/github/callback

# Orbit Vercel Integration (one-time platform setup; normal users authorize in Vercel)
VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=https://orbit-two-delta.vercel.app/api/integrations/vercel/callback

# Vercel Cron and optional manual worker access
CRON_SECRET=
FOUNDRY_WORKER_SECRET=
FOUNDRY_APP_URL=https://orbit-two-delta.vercel.app

# Airtable Students sync
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=appgvElGxaKEYU7Hr
AIRTABLE_STUDENTS_TABLE_ID=tblrJ8uzgxGIUOPAD

# Notion Foundry Students data source
NOTION_API_KEY=
NOTION_DATA_SOURCE_ID=e84c62d2-57ed-4a46-b1ca-c453328a4e72
NOTION_API_VERSION=2026-03-11

# Transactional email through Resend
RESEND_API_KEY=
FOUNDRY_EMAIL_FROM=Urava Foundry <updates@example.com>

# WhatsApp Cloud API. The template must be approved and accept three body
# parameters: notification title, notification body, and Orbit login URL.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=foundry_update
WHATSAPP_TEMPLATE_LANGUAGE=en_US
